{
  "name": "razor-path",
  "private": true,
  "type": "module",
  "scripts": {
    "android:export-debug": "mkdir -p build/android && ${GODOT:-godot} --headless --path . --export-debug Android build/android/RazorPath-debug.apk",
    "check": "pnpm test",
    "test": "tmp=$(mktemp -d); XDG_DATA_HOME=\"$tmp\" ${GODOT:-godot} --headless --audio-driver Dummy --path . --script test/native_extension_smoke.gd; status=$?; rm -rf \"$tmp\"; exit $status",
    "test:preview": "tmp=$(mktemp -d); XDG_DATA_HOME=\"$tmp\" ${GODOT:-godot} --audio-driver Dummy --path . --script test/native_preview_capture.gd; status=$?; rm -rf \"$tmp\"; exit $status",
    "test:checks": "node --test test/godot-check.test.mjs test/exported-pack-profile.test.mjs test/razor-gen.test.mjs",
    "dev": "node scripts/manus/runtime-command.cjs ./server.mjs",
    "build": "node scripts/manus/runtime-command.cjs ./build.mjs",
    "preview:build": "node scripts/manus/runtime-command.cjs ./preview-build.mjs",
    "preview:status": "node scripts/manus/runtime-command.cjs ./preview-build.mjs --status",
    "doctor": "node scripts/manus/runtime-command.cjs ./doctor.mjs",
    "inspect": "node scripts/manus/runtime-command.cjs ./inspect-file.mjs",
    "assets:report": "node scripts/manus/runtime-command.cjs ./asset-provenance.mjs"
  }
}
